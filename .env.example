# Optional. The default Compose setup requires no .env file or cloud credentials.
AI_PROVIDER=ollama
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
JEV_MODEL=jev-latest
CLM_MODEL=clm-latest
AI_WARMUP=true
WEB_PORT=3000
# AI_PROVIDER sets the initial preference; the UI can switch providers per request.
# Configure this key once to enable Jev in AI preferences. Keep it server-side.
# TYPESAFE_API_KEY=
# Configure the base URL of a running CLM server to enable CLM in AI preferences.
# For a native CLM server reached from Docker Desktop / Rancher Desktop:
# CLM_URL=http://host.docker.internal:8700
# Optional: only needed when the CLM server requires a key. Keep it server-side.
# CLM_API_KEY=
# For native Ollama from Docker Desktop (faster on Apple Silicon):
# OLLAMA_URL=http://host.docker.internal:11434
